@model Ecommerce.UI.ViewModel.ProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="container">
    <h2 class="mb-4">Create New Product</h2>

    <div class="card">
        <div class="card-body">
            <form asp-area="Admin" asp-controller="Products" asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Product Name</label>
                        <input asp-for="Product.ProductName" id="ProductName" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Price</label>
                        <input asp-for="Product.Price" id="Price" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Product.Description" id="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Category</label>
                        <select asp-for="Product.CategoryId" class="form-select" id="categorySelect" required>
                            <option value="">Select Category</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id">@cat.Category</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Sub-Category</label>
                        <select asp-for="Product.SubCategoryId" class="form-select" id="subCategorySelect" required>
                            <option value="">Select Sub-Category</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Gender</label>
                        <select asp-for="Product.GenderId" class="form-select" id="genderSelect" required>
                            <option value="">Select Gender</option>
                            @foreach (var gen in Model.Genders)
                            {
                                <option value="@gen.Id">@gen.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-12 mb-3 form-check">
                        <input asp-for="Product.IsActive" class="form-check-input" type="checkbox" id="isActiveCheck">
                        <label class="form-check-label" for="isActiveCheck">Active</label>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="button" onclick="saveProduct()" class="btn btn-primary">Save Product</button>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function saveProduct() {
            console.log("Starting saveProduct process...");

            // Gather data from UI using the new explicit IDs
            var productName = $('#ProductName').val();
            var priceVal = $('#Price').val();
            var description = $('#Description').val();
            var categoryIdVal = $('#categorySelect').val();
            var subCategoryIdVal = $('#subCategorySelect').val();
            var genderIdVal = $('#genderSelect').val();
            var isActive = $('#isActiveCheck').is(':checked');

            console.log("UI Values:", {
                productName,
                priceVal,
                description,
                categoryIdVal,
                subCategoryIdVal,
                genderIdVal,
                isActive
            });

            // Convert to correct types
            var productData = {
                ProductName: productName,
                Price: parseFloat(priceVal),
                Description: description,
                CategoryId: parseInt(categoryIdVal),
                SubCategoryId: parseInt(subCategoryIdVal),
                GenderId: parseInt(genderIdVal),
                IsActive: isActive
            };

            console.log("Processed Product Data:", productData);

            // Detailed Validation
            var errors = [];
            if (!productData.ProductName || productData.ProductName.trim() === "") errors.push("Product Name");
            if (isNaN(productData.Price)) errors.push("Price");
            if (isNaN(productData.CategoryId)) errors.push("Category");
            if (isNaN(productData.SubCategoryId)) errors.push("Sub-Category");
            if (isNaN(productData.GenderId)) errors.push("Gender");

            if (errors.length > 0) {
                console.error("Validation failed for fields:", errors);
                alert('Please fill in all required fields correctly: ' + errors.join(", "));
                return;
            }

            $.ajax({
                url: '/Admin/Products/CreateAjax',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(productData),
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        window.location.href = '/Admin/Products/Index';
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Creation error:", xhr.responseText);
                    alert('An unexpected error occurred while creating the product.');
                }
            });
        }

        $(document).ready(function () {
            $('#categorySelect').change(function () {
                var categoryId = $(this).val();
                var $subCatSelect = $('#subCategorySelect');

                $subCatSelect.empty().append('<option value="">Loading...</option>');

                if (!categoryId) {
                    $subCatSelect.empty().append('<option value="">Select Sub-Category</option>');
                    return;
                }

                $.getJSON('https://localhost:7156/api/Product/categories/' + categoryId + '/subcategories', function (data) {
                    $subCatSelect.empty().append('<option value="">Select Sub-Category</option>');
                    $.each(data, function (i, item) {
                        $subCatSelect.append($('<option>', {
                            value: item.id || item.Id,
                            text: item.subCategory || item.SubCategory
                        }));
                    });
                }).fail(function(xhr, status, error) {
                    console.error("Error fetching subcategories: ", error);
                    $subCatSelect.empty().append('<option value="">Error loading sub-categories</option>');
                });
            });
        });
    </script>
}
