@model Ecommerce.UI.ViewModel.ProductViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container">
    <h2 class="mb-4">Edit Product</h2>
    <div class="alert alert-info">
        Debug: Product Name = @(Model.Product?.ProductName ?? "NULL") | ID = @(Model.Product?.Id)
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-area="Admin" asp-controller="Products" asp-action="Edit" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input type="hidden" id="ProductId" name="Product.Id" value="@Model.Product?.Id" />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Product Name</label>
                        <input name="Product.ProductName" id="ProductName" class="form-control" value="@Model.Product?.ProductName" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Price</label>
                        <input name="Product.Price" id="Price" type="number" step="0.01" class="form-control" value="@Model.Product?.Price" required />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Product.Description" id="Description" class="form-control" rows="3">@Model.Product?.Description</textarea>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Category</label>
                        <select name="Product.CategoryId" class="form-select" id="categorySelect" required>
                            <option value="">Select Category</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.Product != null && Model.Product.CategoryId == cat.Id ? "selected" : null)">@cat.Category</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Sub-Category</label>
                        <select name="Product.SubCategoryId" class="form-select" id="subCategorySelect" required>
                            <option value="">Select Sub-Category</option>
                            @foreach (var sub in Model.SubCategories)
                            {
                                <option value="@sub.Id" selected="@(Model.Product.SubCategoryId == sub.Id ? "selected" : null)">@sub.SubCategory</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Gender</label>
                        <select name="Product.GenderId" class="form-select" id="genderSelect" required>
                            <option value="">Select Gender</option>
                            @foreach (var gen in Model.Genders)
                            {
                                <option value="@gen.Id" selected="@(Model.Product.GenderId == gen.Id ? "selected" : null)">@gen.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-12 mb-3 form-check">
                        <input name="Product.IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" checked="@(Model.Product?.IsActive == true ? "checked" : null)">
                        <label class="form-check-label" for="isActiveCheck">Active</label>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="button" onclick="updateProduct()" class="btn btn-primary">Update Product</button>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateProduct() {
            console.log("Starting updateProduct process...");

            // Gather data from UI using explicit IDs
            var productId = $('#ProductId').val();
            var productName = $('#ProductName').val();
            var priceVal = $('#Price').val();
            var description = $('#Description').val();
            var categoryIdVal = $('#categorySelect').val();
            var subCategoryIdVal = $('#subCategorySelect').val();
            var genderIdVal = $('#genderSelect').val();
            var isActive = $('#isActiveCheck').is(':checked');

            console.log("UI Values:", {
                productId,
                productName,
                priceVal,
                description,
                categoryIdVal,
                subCategoryIdVal,
                genderIdVal,
                isActive
            });

            // Convert to correct types
            var productData = {
                Id: parseInt(productId),
                ProductName: productName,
                Price: parseFloat(priceVal),
                Description: description,
                CategoryId: parseInt(categoryIdVal),
                SubCategoryId: parseInt(subCategoryIdVal),
                GenderId: parseInt(genderIdVal),
                IsActive: isActive
            };

            console.log("Processed Product Data:", productData);

            // Detailed Validation
            var errors = [];
            if (!productData.Id || isNaN(productData.Id)) errors.push("Product ID");
            if (!productData.ProductName || productData.ProductName.trim() === "") errors.push("Product Name");
            if (isNaN(productData.Price)) errors.push("Price");
            if (isNaN(productData.CategoryId)) errors.push("Category");
            if (isNaN(productData.SubCategoryId)) errors.push("Sub-Category");
            if (isNaN(productData.GenderId)) errors.push("Gender");

            if (errors.length > 0) {
                console.error("Validation failed for fields:", errors);
                alert('Please fill in all required fields correctly: ' + errors.join(", "));
                return;
            }

            $.ajax({
                url: '/Admin/Products/EditAjax',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(productData),
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        window.location.href = '/Admin/Products/Index';
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Update error:", xhr.responseText);
                    alert('An unexpected error occurred while updating the product.');
                }
            });
        }

        $(document).ready(function () {
            var currentSubCategoryId = '@Model.Product?.SubCategoryId';

            $('#categorySelect').change(function () {
                var categoryId = $(this).val();
                var $subCatSelect = $('#subCategorySelect');

                $subCatSelect.empty().append('<option value="">Loading...</option>');

                if (!categoryId) {
                    $subCatSelect.empty().append('<option value="">Select Sub-Category</option>');
                    return;
                }

                $.getJSON('https://localhost:7156/api/Product/categories/' + categoryId + '/subcategories', function (data) {
                    $subCatSelect.empty().append('<option value="">Select Sub-Category</option>');
                    $.each(data, function (i, item) {
                        var id = item.id || item.Id;
                        var text = item.subCategory || item.SubCategory;
                        var isSelected = (id == currentSubCategoryId) ? 'selected' : '';
                        $subCatSelect.append('<option value="' + id + '" ' + isSelected + '>' + text + '</option>');
                    });
                }).fail(function(xhr, status, error) {
                    console.error("Error fetching subcategories: ", error);
                    $subCatSelect.empty().append('<option value="">Error loading sub-categories</option>');
                });
            });

            // Trigger initial load of subcategories based on the selected category
            if ($('#categorySelect').val()) {
                $('#categorySelect').trigger('change');
            }
        });
    </script>
}
