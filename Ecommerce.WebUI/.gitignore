# Client-side libraries (installed via libman — restore on build)
wwwroot/lib/

# Bundled / minified frontend assets (regenerated on build)
wwwroot/dist/
wwwroot/css/site.min.css
wwwroot/js/site.min.js

# Local development config (may contain secrets / connection strings)
appsettings.Development.json

# Local database files
*.db
*.db-journal

# Logs
*.log
logs/

# Node modules (if using any JS tooling)
node_modules/

# NuGet local cache (if restored locally)
packages/
