## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
*.VisualState.xml
TestResult.xml

# Roaming user-specific files
*.vshost.exe

*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.scc
*.tlb

# Build results of a Visual Studio upgrade
[Bb]ackup/
[Bb]in/
[Oo]bjs/
upgrade_log.htm

# .NET Core / ASP.NET Core
*.db
*.db-journal
appsettings.Development.json
*.log

# publish
pub/
publish/
*.pubxml
*.publishproj

# NuGet
*.nupkg
*.nupkg.metadata
*.snupkg
packages/
*.nuget.props
*.nuget.targets

# Windows Azure Log Files
csx/
*.build.csdef

# Windows Store app package directories and files
AppPackages/
BundleArtifacts/
*.appx
*.appxbundle
*.appxupload

# Visual Studio cache/options directory
*.suo

# SQL Server files
*.mdf
*.ldf
*.edmx.sql

# Test results
*.trx
[Tt]est[Rr]esult*/

# SpecFlow
SpecFlowAssemblies/

# NUnit 3
TestResults/

# VB & C# temporary files
*.tmp
*.user

# Xamarin / Xamarin.Forms
*.mtm
*.hdmp
ovs.log

# Packed files
[Ww]eb[Pp]ublish/
*.dll.tmp

# Virtual Store directory
~$*

# Backup folder
[Bb]ackup/

# Please include the .glb file in the project for mobile
*.glb

# Rider
.idea/

# Fody - auto-generated XML schema
FodyWeavers.xsd

# VS Code files
.vscode/
.settings/

# Local Claude Code configuration (contains env/auth tokens, machine-specific)
.claude/